<Window x:Class="NecoArcDesktopPet.WorkbenchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neco-Arc 工作台" Width="820" Height="740" FontSize="13"
        MinWidth="700" MinHeight="520" WindowStartupLocation="CenterOwner"
        Topmost="False" ResizeMode="CanResize" UseLayoutRounding="True"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WorkbenchWindow.Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="124" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox x:Name="Navigation" Grid.Row="0" Margin="12,16,0,16"
                 VerticalAlignment="Stretch" SelectedIndex="0"
                 BorderThickness="0" Background="Transparent"
                 ItemContainerStyle="{StaticResource NavigationItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnNavigationChanged">
            <ListBoxItem Content="常规" />
            <ListBoxItem Content="行为" />
            <ListBoxItem Content="移动" />
            <ListBoxItem Content="交互" />
            <ListBoxItem Content="诊断" />
        </ListBox>
        <Grid Grid.Column="1" Margin="20,16,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitleStyle}" Text="常规" />
            <Border x:Name="ErrorArea" Grid.Row="1" Visibility="Collapsed" BorderBrush="Firebrick"
                    BorderThickness="1" Padding="10" Margin="0,0,0,12" MaxHeight="120">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
            <ScrollViewer x:Name="PageScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,12">
                <Grid Grid.IsSharedSizeScope="True">
                    <StackPanel x:Name="Page0">
                        <GroupBox Header="窗口行为">
                            <StackPanel x:Name="WindowBehaviorSettings">
                                <CheckBox x:Name="TopmostSetting" Content="始终置顶"
                                          Checked="OnEditableChanged" Unchecked="OnEditableChanged" />
                                <TextBlock Text="让猫姬窗口保持在其他普通窗口上方。" Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                    <StackPanel x:Name="Page1" Visibility="Collapsed" />
                    <StackPanel x:Name="Page2" Visibility="Collapsed" />
                    <StackPanel x:Name="Page3" Visibility="Collapsed" />
                    <StackPanel x:Name="Page4" Visibility="Collapsed" />
                </Grid>
            </ScrollViewer>
        </Grid>
        <Border x:Name="Footer" Grid.Row="1" Grid.ColumnSpan="2" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                           Text="修改后点击“应用”生效。" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ResetButton" Style="{StaticResource FooterButtonStyle}" Content="恢复默认" Click="OnResetDefaults" />
                    <Button x:Name="CancelButton" Style="{StaticResource FooterButtonStyle}" Content="取消" Click="OnCancel" IsCancel="True" />
                    <Button x:Name="ApplyButton" Style="{StaticResource FooterButtonStyle}" Content="应用" Click="OnApply" IsDefault="True" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
