<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Coordinates/PhysicalCoordinates.cs" Link="Coordinates/PhysicalCoordinates.cs" />
    <Compile Include="../../Coordinates/MonitorSnapshot.cs" Link="Coordinates/MonitorSnapshot.cs" />
    <Compile Include="../../Pilot/Physics/*.cs" Link="Physics/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
