<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>NecoArcDesktopPet</AssemblyName>
    <RootNamespace>NecoArcDesktopPet</RootNamespace>
    <AssemblyTitle>Neco-Arc Desktop Pet</AssemblyTitle>
    <Product>Neco-Arc Desktop Pet</Product>
    <!-- WPF Page globs must also exclude historical builds when BaseOutputPath changes. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**;tests/**;docs/**;scripts/**;tools/**;.local/**;dist/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DesktopPetPmv2Pilot)' == 'true'">
    <AssemblyName>NecoArcDesktopPet.PMv2Pilot</AssemblyName>
    <ApplicationManifest>Pilot/app.manifest</ApplicationManifest>
    <StartupObject>NecoArcDesktopPet.Pilot.PilotEntry</StartupObject>
    <DefineConstants>$(DefineConstants);PMV2_PILOT</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DesktopPetProduct)' == 'true'">
    <AssemblyName>NecoArcDesktopPet.Product</AssemblyName>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- LICENSE names no publisher/rightsholder; do not turn the assembly name into a company. -->
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyCopyrightAttribute>false</GenerateAssemblyCopyrightAttribute>
    <ApplicationManifest>Product/app.manifest</ApplicationManifest>
    <StartupObject>NecoArcDesktopPet.Product.ProductEntry</StartupObject>
    <DefineConstants>$(DefineConstants);PMV2_PILOT;PMV2_PRODUCT</DefineConstants>
  </PropertyGroup>

  <Target Name="ValidateProductBuild" BeforeTargets="PrepareForBuild"
          Condition="'$(DesktopPetProduct)' == 'true' and '$(DesktopPetPmv2Pilot)' == 'true'">
    <Error Text="Select either DesktopPetProduct or DesktopPetPmv2Pilot, not both." />
  </Target>

